<mujoco model="scene_allcollisions_ball_goal">
    <!-- scene_allcollisions_ball.xml + goal.xml (two mocap goals, parked far away until a
         mission places one). Fork-local, GoalKick rung 5. The ball scene itself is left
         untouched so every published BallKick/PrecisionStep number stays reproducible. -->
    <include file="robot_allcollisions.xml" />
    <include file="ball.xml" />
    <include file="goal.xml" />

    <!-- Pin the render statistics to scene_allcollisions_ball.xml's computed values. Without
         this the goals parked at +-50 m make the model extent 100 m instead of 0.415 m; MuJoCo
         scales the shadow map and the near/far clip by the extent, which gave blocky shadows
         under the duck/ball and black z-fighting lines at the horizon (Dillon's viewer,
         2026-11-14). Render-only: physics never reads these. A 2v2 field scene needs the same. -->
    <statistic extent="0.415" center="0.128 0 0.162" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
    </worldbody>
</mujoco>
