<mujoco model="scene_field">
    <!-- scene_allcollisions_ball_goal.xml + field.xml (rung 6 Stage 2): the 2v2 field's boards
         around the GoalKick mission. Both goals are live: a mission places goal_a, and while
         none does, setup_field() parks goal_a and goal_b in the field's two goal mouths (x = +-3).
         The goal scene itself is left untouched so the published GoalKick numbers stay
         reproducible. -->
    <include file="robot_allcollisions.xml" />
    <include file="ball.xml" />
    <include file="goal.xml" />
    <include file="field.xml" />

    <!-- Render statistics pinned as in the goal scene (the GoalKick render lesson). BAM's
         mj_setConst recomputes them, so setup_field() restores these in code too. -->
    <statistic extent="0.415" center="0.128 0 0.162" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
    </worldbody>
</mujoco>
